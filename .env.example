# =====================================
DATABASE_URL=postgresql://postgres:QF1siEAJnnVwdwl4@db.cthammossxdzneiqxfnp.supabase.co:5432/postgres?schema=indicacao
NEXT_PUBLIC_APP_URL=indicacao.rrs.com.br
