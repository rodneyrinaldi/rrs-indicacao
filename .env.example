# =====================================
# DESENVOLVIMENTO LOCAL NO WINDOWS
# Postgres em container local
# Copie para .env.dev
# O projeto usa schema explicito nas queries (indicacao.tabela)
# Entao a conexao nao precisa carregar informacao de schema
# =====================================
DB_NAME=r2-database
DB_USER=r2-user 
DB_PASS=r2-password
DB_HOST=localhost
DATABASE_URL=postgresql://r2-user:r2-password@localhost:5432/r2-database
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_KEY=SenhaFoda1966

# =====================================
# DESENVOLVIMENTO COM SUPABASE CLOUD
# Copie para .env.prod.supabase
# Mantenha so a URL normal do Postgres/Supabase
# Nao acrescente schema na conexao; o codigo usa indicacao.tabela
# =====================================
DATABASE_URL=postgresql://postgres:QF1siEAJnnVwdwl4@db.cthammossxdzneiqxfnp.supabase.co:5432/postgres?schema=indicacao
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_KEY=SenhaFoda1966

# =====================================
# PRODUCAO NA VERCEL
