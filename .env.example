# ==============================
# DEV (Windows + Docker Postgres)
# ==============================
# Copie para .env.dev
DB_CONNECTION_MODE=local
# PRIMARY_DB=local # legado (compatibilidade)
DB_USER=r2-user
DB_PASS=r2-password
DB_NAME=r2-database
DATABASE_URL=postgresql://r2-user:r2-password@localhost:5432/r2-database
DB_HOST_FALLBACK=localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPER_ADMIN_KEY=trocar-esta-chave

# ==========================================
# PROD LOCAL (Linux + Next.js + Postgres)
# ==========================================
# Copie para .env.prod.local
# DB_CONNECTION_MODE=local
# PRIMARY_DB=local # legado (compatibilidade)
# DB_USER=r2-user
# DB_PASS=r2-password
# DB_NAME=r2-database
# DATABASE_URL=postgresql://r2-user:r2-password@postgres:5432/r2-database
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# SUPER_ADMIN_KEY=trocar-esta-chave

# ==========================================
# SUPABASE (Linux container ou Vercel)
# ==========================================
# Copie para .env.prod.supabase (Linux container) ou configure na Vercel
# DB_CONNECTION_MODE=supabase
# PRIMARY_DB=supabase # legado (compatibilidade)
# SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com
# SUPER_ADMIN_KEY=trocar-esta-chave
