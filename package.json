{
  "name": "indicacao",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "env:validate:dev": "node scripts/validate-env.cjs dev",
    "env:validate:supabase": "node scripts/validate-env.cjs supabase",
    "env:validate:vercel": "node scripts/validate-env.cjs vercel",
    "db:build": "docker compose up -d",
    "db:up": "docker compose up",
    "db:down": "docker compose down",
    "db:restart": "docker compose restart postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:ps": "docker compose ps",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:shell": "docker exec -it r2-postgres psql -U r2-user -d r2-database",
    "supa:cloud:url": "node scripts/open-supabase-dashboard.cjs --print",
    "supa:cloud:open": "node scripts/open-supabase-dashboard.cjs",
    "vercel:check": "dotenv -e .env -- node scripts/validate-env.cjs vercel"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "next": "^16.2.7",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
